# Copy to .env on the VM and adjust. Used by docker-compose.

# Public URL of the backend API the browser calls (booking + distance).
# Must be reachable from the visitor's browser — NOT 127.0.0.1 / 0.0.0.0.
VITE_API_URL=http://34.148.97.95:8000

# Host port the frontend is published on. This is a secondary app, so 3000.
# Reachable at http://<VM_IP>:3000/
PORT=3000

# Google Maps JS API key for address autocomplete. Referrer-restrict it in the
# Google Cloud console — it ships in the client bundle.
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key

# Cloudflare Turnstile site key — bot protection on the quote/pay/booking calls.
# Public (ships in the client bundle); the backend verifies each token with its
# secret. Blank disables it. Baked in at build time — rebuild after changing.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ATS iframe identity. Public identifier (names this iframe → its payer), NOT a
# secret. Each deployed iframe gets its own UUID from the ATS backend.
# API base reuses VITE_API_URL above.
VITE_ATS_SOURCE=iframe
VITE_ATS_IFRAME_UUID=your-iframe-uuid
